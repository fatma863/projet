@startuml sprint4_sequence_notif
!theme plain
skinparam sequenceArrowThickness 2
skinparam participantBackgroundColor #F5F3FF
skinparam participantBorderColor #6D28D9

participant "Laravel\nScheduler" as SCHED #EDE9FE
participant "NotificationService" as NS #F5F3FF
participant "Reverb\nWebSocket" as RB #DCFCE7
participant "React\n(NotificationBell)" as R #EDE9FE
database "MySQL" as DB #DBEAFE

note over SCHED : Exécution toutes les heures

SCHED -> DB : SELECT tasks\nWHERE due_date < now()\nAND workflow_status != 'done'\nAND updated_at < now() - 1h

DB --> SCHED : Liste des tâches en retard

loop Pour chaque tâche en retard
  SCHED -> NS  : notifyDelay(task, assignees)
  NS -> DB     : Notification::create(\n  type='task_delayed',\n  user_id=assignee_id,\n  data={task_id, task_title})
  NS -> RB     : broadcast(TaskDelayed)\n  canal: private-user.{id}
  RB --> R     : Événement WebSocket
  R -> R       : badge++ et toast affiché
end

@enduml
