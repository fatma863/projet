@startuml sprint5_class
!theme plain
skinparam classBackgroundColor #F5F3FF
skinparam classBorderColor #6D28D9
skinparam classFontColor #1E1B4B
skinparam arrowColor #6D28D9

class AiRecommendation {
  +id: bigint
  +task_id: bigint
  +project_id: bigint
  +type: assignment|estimation|risk
  +input_data: json
  +result_data: json
  +confidence: float
  +created_at: datetime
}

class AIService {
  +estimateDuration(task): array
  +assessRisk(task): array
  +chat(messages, context): string
  -buildPrompt(task, similar): string
  -callOpenRouter(prompt): string
}

class MLController {
  +recommend(task): JsonResponse
  +train(project): JsonResponse
  +metrics(project): JsonResponse
}

class FastAPIRecommender {
  +train(): dict
  +recommend(task_id): list
  -collect_training_data(): DataFrame
  -build_feature_vector(task, user): array
  --
  model: VotingClassifier | LogisticRegression
}

class FeatureExtractor {
  +extract(task, user, project): array
  -- 5 familles × 22 features --
  +specialties_match(task, user): float
  +current_workload(user): float
  +historical_performance(user): float
  +context_familiarity(user, project): float
  +collaboration_trend(user): float
}

class VotingClassifier {
  +estimators: [(gbm, GBM), (rf, RF)]
  +voting: soft
  +fit(X, y): void
  +predict_proba(X): array
}

MLController ..> AIService : délègue LLM
MLController ..> FastAPIRecommender : appelle via HTTP
FastAPIRecommender *-- FeatureExtractor : utilise
FastAPIRecommender *-- VotingClassifier : entraîne
MLController --> AiRecommendation : persiste résultat

@enduml
