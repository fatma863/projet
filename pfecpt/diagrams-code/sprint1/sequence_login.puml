@startuml sprint1_sequence_login
!theme plain
skinparam sequenceArrowThickness 2
skinparam participantBackgroundColor #F5F3FF
skinparam participantBorderColor #6D28D9
skinparam sequenceLifeLineBorderColor #8B5CF6
skinparam noteBorderColor #6D28D9
skinparam noteBackgroundColor #EDE9FE

actor Utilisateur as U
participant "React\n(LoginPage)" as R #EDE9FE
participant "AuthController" as AC #F5F3FF
participant "User Model" as UM #F5F3FF
participant "Sanctum" as S #F5F3FF
database "MySQL" as DB #DBEAFE

U  -> R  : Saisit email + mot de passe
R  -> R  : Validation Zod + RHF (client)
R  -> AC : POST /api/auth/login\n{email, password}
AC -> UM : User::where('email')->first()
UM -> DB : SELECT * FROM users WHERE email = ?
DB --> UM : $user

alt Compte désactivé
  AC --> R : 422 {email: "Compte désactivé"}
  R --> U  : Affiche erreur
else Mauvais mot de passe
  AC --> R : 422 {email: "Identifiants incorrects"}
  R --> U  : Affiche erreur
else Connexion réussie
  AC -> S  : $user->createToken('intellipm-web')
  S  -> DB : INSERT personal_access_tokens
  DB --> S : token record
  S  --> AC : plainTextToken
  AC --> R  : 200 {token, user: UserResource}
  R  -> R   : Stocke token (localStorage)
  R  --> U  : Redirection /dashboard
end

@enduml
