@startuml sprint5_sequence_ml
!theme plain
skinparam sequenceArrowThickness 2
skinparam participantBackgroundColor #F5F3FF
skinparam participantBorderColor #6D28D9

actor "Member" as M
participant "React\n(MLCandidatePanel)" as R #EDE9FE
participant "MLController\n(Laravel)" as MLC #F5F3FF
participant "FastAPI\n(Python)" as FA #DCFCE7
participant "SQLAlchemy\n(DB read)" as SQL #F0FDF4
participant "FeatureExtractor" as FE #F0FDF4
participant "VotingClassifier\n(GBM + RF)" as VC #F0FDF4
participant "AiRecommendation\n(Model)" as AR #F5F3FF
database "MySQL" as DB #DBEAFE

M  -> R   : Clique "Voir recommandations"
R  -> MLC : GET /api/ml/recommend/{task_id}\nBearer Token

MLC -> FA  : HTTP GET /recommend/{task_id}\ntimeout: 3s

FA -> SQL  : Charge tâche + candidats\ndu projet
SQL -> DB  : SELECT tasks, users, assignments
DB --> SQL : Données projet

FA -> FE   : build_feature_vectors(\n  task, candidates)
note right of FE : 22 features par candidat
FE --> FA  : X_candidates (n × 22)

FA -> VC   : predict_proba(X_candidates)
VC --> FA  : scores[][0..1]

FA -> FA   : generate_explanation(features, score)
FA --> MLC : [{user_id, name, score, explanation}]

MLC -> AR  : AiRecommendation::create(\n  type='assignment', confidence, result_data)
AR -> DB   : INSERT ai_recommendations

MLC --> R  : 200 [{user_id, name, score, explanation}]
R --> M    : Affiche liste classée\npar score décroissant

@enduml
