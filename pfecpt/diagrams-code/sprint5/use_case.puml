@startuml sprint5_use_case
!theme plain
skinparam actorStyle awesome
skinparam usecaseBackgroundColor #F5F3FF
skinparam usecaseBorderColor #6D28D9
left to right direction

actor "Member" as Member #8B5CF6
actor "Admin" as Admin #6D28D9
actor "Service ML\n(FastAPI)" as ML <<system>> #059669
actor "LLM\n(OpenRouter)" as LLM <<system>> #0891B2

rectangle "Sprint 5 — Intelligence Artificielle" {
  usecase "Recommandation ML\nd'assignation" as UC1
  usecase "Voir score +\nexplication candidat" as UC2
  usecase "Estimer durée\npar LLM" as UC3
  usecase "Score risque\ntâche" as UC4
  usecase "Score risque\nprojet" as UC5
  usecase "Chat assistant\nIA" as UC6
  usecase "Relancer\nentraînement ML" as UC7
  usecase "Voir métriques\ndu modèle" as UC8
}

Member --> UC1
Member --> UC2
Member --> UC3
Member --> UC4
Member --> UC5
Member --> UC6
Admin --> UC7
Admin --> UC8

UC1 --> ML : <<use>>
UC3 --> LLM : <<use>>
UC4 --> LLM : <<use>>
UC5 --> LLM : <<use>>
UC6 --> LLM : <<use>>
UC1 ..> UC2 : <<include>>

@enduml
