@startuml sprint2_use_case
!theme plain
skinparam actorStyle awesome
skinparam usecaseBackgroundColor #F5F3FF
skinparam usecaseBorderColor #6D28D9
left to right direction

actor "Chef de projet" as Chef #6D28D9
actor "Member" as Member #8B5CF6
actor "Admin" as Admin #7C3AED
actor "Service Email" as Email <<system>> #059669

rectangle "Sprint 2 — Projets et Équipes" {
  usecase "Créer un projet" as UC1
  usecase "Modifier / archiver\nprojet" as UC2
  usecase "Statuts Kanban\npersonnalisés" as UC3
  usecase "Inviter par email\n(7 jours)" as UC4
  usecase "Ajouter / retirer\nmembres" as UC5
  usecase "Créer un sprint" as UC6
  usecase "Démarrer un sprint" as UC7
  usecase "Clôturer sprint +\nreport backlog" as UC8
  usecase "Liste des projets" as UC9
  usecase "Dashboard projet" as UC10
  usecase "Gérer équipes" as UC11
  usecase "Administrer\nutilisateurs" as UC12
}

Member --> UC1
Member --> UC9
Member --> UC10

Chef --> UC2
Chef --> UC3
Chef --> UC4
Chef --> UC5
Chef --> UC6
Chef --> UC7
Chef --> UC8

Admin --> UC11
Admin --> UC12

UC4 ..> Email : <<include>>

@enduml
