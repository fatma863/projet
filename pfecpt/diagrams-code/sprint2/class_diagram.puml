@startuml sprint2_class
!theme plain
skinparam classBackgroundColor #F5F3FF
skinparam classBorderColor #6D28D9
skinparam classFontColor #1E1B4B
skinparam arrowColor #6D28D9

class Project {
  +id: bigint
  +name: string
  +code: string
  +description: text
  +status: planning|active|suspended|archived
  +priority: low|medium|high|urgent
  +start_date: date
  +end_date: date
  +team_id: bigint
  +owner_id: bigint
}

class Sprint {
  +id: bigint
  +project_id: bigint
  +name: string
  +goal: string
  +start_date: date
  +end_date: date
  +status: planned|active|completed
  +started_at: datetime
  +completed_at: datetime
}

class TaskStatus {
  +id: bigint
  +project_id: bigint
  +name: string
  +color: string
  +order: int
}

class Team {
  +id: bigint
  +name: string
  +description: text
  +leader_id: bigint
}

class ProjectInvitation {
  +id: bigint
  +project_id: bigint
  +email: string
  +role: owner|manager|developer|viewer
  +token: UUID
  +status: pending|accepted|expired
  +invited_by: bigint
  +expires_at: datetime
}

class ProjectMember {
  +project_id: bigint
  +user_id: bigint
  +role: owner|manager|developer|viewer
}

Project "1" *-- "0..*" Sprint : planifie
Project "1" *-- "0..*" TaskStatus : configure
Project "0..*" --o "1" Team : appartient à
Project "1" -- "0..*" ProjectInvitation : émet
Project "1" -- "0..*" ProjectMember : a pour membres

@enduml
