@startuml sprint4_use_case
!theme plain
skinparam actorStyle awesome
skinparam usecaseBackgroundColor #F5F3FF
skinparam usecaseBorderColor #6D28D9
left to right direction

actor "Admin" as Admin #6D28D9
actor "Member" as Member #8B5CF6
actor "Client" as Client #A78BFA

rectangle "Sprint 4 — Planification visuelle et notifications" {
  usecase "Gantt vue globale\n(multi-projets)" as UC1
  usecase "Gantt vue projet\n+ chemin critique" as UC2
  usecase "Calendrier\nmensuel" as UC3
  usecase "Notification\ntemps réel" as UC4
  usecase "Marquer\ncomme lu" as UC5
  usecase "Configurer\npréférences notifs" as UC6
  usecase "Dashboard\nmember" as UC7
  usecase "Dashboard\nadmin" as UC8
  usecase "Rapport\nclient" as UC9
  usecase "Recherche\nglobale" as UC10
  usecase "Journal\nd'audit" as UC11
}

Member --> UC1
Member --> UC2
Member --> UC3
Member --> UC4
Member --> UC5
Member --> UC6
Member --> UC7
Member --> UC10

Admin --> UC8
Admin --> UC11

Client --> UC9
Client --> UC4

@enduml
