@startuml sprint6_use_case
!theme plain
skinparam actorStyle awesome
skinparam usecaseBackgroundColor #F0FDF4
skinparam usecaseBorderColor #059669
skinparam packageBorderColor #059669
left to right direction

actor "Admin" as Admin #059669
actor "Member" as Member #8B5CF6
actor "Système\n(WebSocket)" as Sys <<system>> #64748B

rectangle "Sprint 6 — Sécurité Enterprise & Journal d'audit" {
  package "RBAC Personnalisable" #F0FDF4 {
    usecase "Créer / modifier\nun rôle" as R1
    usecase "Affecter permissions\natomiques au rôle" as R2
    usecase "Consulter la matrice\ndes permissions" as R3
    usecase "Assigner un rôle\nà un utilisateur" as R4
  }
  package "Journal d'audit Enterprise" #ECFDF5 {
    usecase "Consulter timeline\naudit enrichie" as A1
    usecase "Voir valeurs\navant/après" as A2
    usecase "Filtrer par module,\ndate, recherche" as A3
    usecase "Exporter rapport\nPDF" as A4
  }
  package "Analytics d'activité" #D1FAE5 {
    usecase "Voir KPIs\nd'activité" as AN1
    usecase "Détecter tâches\ninstables" as AN2
    usecase "Détecter membres\ninactifs" as AN3
    usecase "Détecter pics\nd'activité" as AN4
  }
  package "Temps réel" #F0FDF4 {
    usecase "Recevoir nouvelles\nactivités live" as RT1
    usecase "Badge nouvelles\nactivités (sidebar)" as RT2
  }
}

Admin --> R1
Admin --> R2
Admin --> R3
Admin --> R4
Admin --> A1
Admin --> A3
Admin --> A4
Admin --> AN1

Member --> A1
Member --> A2
Member --> A3

A1 ..> A2 : <<include>>
AN1 ..> AN2 : <<include>>
AN1 ..> AN3 : <<include>>
AN1 ..> AN4 : <<include>>

Sys --> RT1 : broadcast ActivityLogged
RT1 ..> RT2 : <<include>>
A1 <.. RT1 : <<extend>>

@enduml
