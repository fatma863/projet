@startuml sprint6_sequence_audit
!theme plain
skinparam sequenceArrowThickness 2
skinparam participantBackgroundColor #F0FDF4
skinparam participantBorderColor #059669

actor "Utilisateur" as U
participant "React\n(UI)" as R #EDE9FE
participant "TaskController\n(Laravel)" as TC #F5F3FF
participant "ActivityLogService" as ALS #F0FDF4
database "activity_logs\n(MySQL)" as DB #DBEAFE
participant "ActivityLogged\n(Event)" as EV #ECFDF5
participant "Laravel Reverb\n(WebSocket)" as WS #F0FDF4
participant "AuditLogPage\n(React)" as ALP #EDE9FE

== Action utilisateur ==
U  -> R   : Modifie une tâche\n(priorité: medium → high)
R  -> TC  : PATCH /api/projects/{id}/tasks/{taskId}\n{ priority: "high" }

TC -> TC  : Capture old_values\nAVANT update\n{ priority: "medium" }
TC -> TC  : $task->update($data)
TC -> TC  : Construit new_values\n{ priority: "high" }

== Journalisation enterprise ==
TC -> ALS : log(project, actor, "task.updated", $task,\n      meta, oldValues, newValues)
note right of ALS
  Auto-détecte :
  • severity = "info"
  • ip_address = Request::ip()
  • user_agent = truncate(500)
  • actor_role = premier rôle Spatie
end note

ALS -> DB : INSERT activity_logs {\n  action, meta, old_values, new_values,\n  changed_fields, ip_address, severity,\n  source, actor_role\n}
DB --> ALS : id = 1042

ALS -> EV : broadcast(ActivityLogged)

== Broadcast WebSocket ==
EV -> WS  : Émet sur\nprivate-project.{id}\nevent: ".activity.logged"

WS --> ALP : { activity: ActivityLogResource }
ALP -> ALP : prepend() en tête de timeline\nsetNewIds(id) → badge vert 4s
ALP -> ALP : liveCount++

TC --> R  : 200 { task: TaskResource }
R  --> U  : Toast "Tâche mise à jour"

== Consultation enrichie ==
U  -> R   : Ouvre le détail de l'entrée
R  -> ALP : expand(entry)
ALP -> ALP : Affiche panneau avant/après\nPriorité : Moyenne → Haute

@enduml
