@startuml sprint3_class
!theme plain
skinparam classBackgroundColor #F5F3FF
skinparam classBorderColor #6D28D9
skinparam classFontColor #1E1B4B
skinparam arrowColor #6D28D9

class Task {
  +id: bigint
  +project_id: bigint
  +sprint_id: bigint
  +parent_id: bigint
  +status_id: bigint
  +title: string
  +description: text
  +issue_type: task|bug|story
  +priority: low|medium|high|urgent
  +workflow_status: todo|in_progress|at_risk|done
  +progress_percent: int
  +story_points: int
  +estimated_hours: decimal
  +actual_hours: decimal
  +risk_level: low|medium|high
  +complexity: int
  +planned_start: date
  +planned_end: date
  +due_date: date
}

class TaskAssignment {
  +task_id: bigint
  +user_id: bigint
  +allocation_percent: int
}

class TaskDependency {
  +id: bigint
  +task_id: bigint
  +depends_on_task_id: bigint
  +type: FS|SS|FF|SF
}

class TaskComment {
  +id: bigint
  +task_id: bigint
  +user_id: bigint
  +parent_id: bigint
  +content: text
}

class Attachment {
  +id: bigint
  +task_id: bigint
  +name: string
  +type: file|link
  +url: string
  +size: int
}

class TimeEntry {
  +id: bigint
  +task_id: bigint
  +user_id: bigint
  +minutes: int
  +description: string
  +source: manual|timer
  +logged_at: date
}

Task "0..1" <-- "0..*" Task : parent / sous-tâche
Task "1" *-- "0..*" TaskAssignment : est assignée via
Task "0..*" -- "0..*" Task : TaskDependency
Task "1" *-- "0..*" TaskComment : a pour commentaires
Task "1" *-- "0..*" Attachment : a pour pièces jointes
Task "1" *-- "0..*" TimeEntry : enregistre le temps

@enduml
